    "@mui/material": "^9.0.1",
    "@tanstack/react-router": "^1.170.4",
    "@tanstack/react-router-devtools": "^1.167.0",
    "@tanstack/react-start": "^1.168.6",
    "chroma-js": "^3.2.0",
    "color-name-list": "^14.37.0",
    "compression": "^1.8.1",
    "lodash.debounce": "^4.0.8",
    "lodash.throttle": "^4.1.1",
    "lucide-react": "^1.16.0",
    "nearest-color": "^0.4.4",
    "nearest-pantone": "^1.0.1",
    "nitro": "3.0.260429-beta",
    "pngjs": "^7.0.0",
    "react": "^19.2.6",
    "react-colorful": "^5.7.0",
    "react-dom": "^19.2.6",
    "react-window": "^2.2.7",
    "srvx": "^0.11.15",
    "zustand": "^5.0.13"
