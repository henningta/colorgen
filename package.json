{
  "name": "colorgen.io",
  "version": "1.0.0",
  "description": "Color visualizer and palette generator tool",
  "author": "Travis Henning",
  "type": "module",
  "license": "MIT",
  "private": true,
  "sideEffects": false,
  "keywords": [
    "colorgen",
    "color",
    "colors",
    "palette",
    "generator",
    "visualizer"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/henningta/colorgen.git"
  },
  "bugs": {
    "url": "https://github.com/henningta/colorgen/issues"
  },
  "scripts": {
    "prepare": "husky",
    "build": "tsc && vite build",
    "dev": "vite dev",
    "preview": "node .amplify-hosting/compute/default/server.js",
    "format": "prettier --write \"**/*.{css,js,jsx,md,ts,tsx}\"",
    "lint": "eslint src/** --ext ts,tsx --report-unused-disable-directives --max-warnings 0"
  },
